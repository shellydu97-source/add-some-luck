# 只填写在本机或部署平台的环境变量中，不要提交真实密钥。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# 面向朋友分享时保留的轻量保护，不需要账号或邀请码。
AI_DAILY_REQUEST_LIMIT=300
AI_PER_IP_HOURLY_LIMIT=60

# 正式预览端口；被占用时服务器会自动尝试后续端口。
PORT=4173
HOST=0.0.0.0

# 可选账号与跨设备同步。Publishable key 可以用于浏览器，安全边界由 Supabase RLS 负责。
# 不要在浏览器环境中使用 service_role key。
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
